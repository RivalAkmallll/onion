{
  "name": "Onion",
  "scopeName": "source.onion",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-def" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.onion",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.onion",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.onion", "match": "\\\\." },
        { "name": "constant.other.placeholder.onion", "match": "\\{\\}|\\{\\{|\\}\\}" }
      ]
    },
    "function-def": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.onion" },
        "2": { "name": "entity.name.function.onion" }
      }
    },
    "macros": {
      "name": "support.function.macro.onion",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!(?!=)"
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.onion", "match": "\\b(if|else|loop|break|continue)\\b" },
        { "name": "storage.type.onion", "match": "\\blet\\b" },
        { "name": "storage.modifier.onion", "match": "\\bmut\\b" }
      ]
    },
    "types": {
      "name": "support.type.primitive.onion",
      "match": "\\b(i32|f64|bool|String)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.onion",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.onion", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.onion", "match": "\\b[0-9]+\\b" }
      ]
    },
    "operators": {
      "name": "keyword.operator.onion",
      "match": "&&|\\|\\||==|!=|<=|>=|\\+=|-=|\\*=|/=|[-+*/%<>=!]"
    }
  }
}